# このファイルを .env にコピーし、実際の値に差し替えて使う。
# .env 自体は .gitignore 済みなのでコミットしないこと。

# --- 必須（ローカル検証には自分の個人検証用キーを使う） ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxxxxxx

# --- 社内承認後に実値へ差し替え（未確定の間は仮値のままでOK） ---
SLACK_CHANNEL_ID=C0000000000
SLACK_ADMIN_USER_ID=U0000000000

# --- 任意 ---
QIITA_ACCESS_TOKEN=

# --- 動作モード ---
# 1: Slackへの実投稿・DM通知をせずログ出力のみ（ロジック検証用・デフォルト）
# 0: 実際にSlackへ投稿・DM通知する（本番用。SLACK_CHANNEL_ID/SLACK_ADMIN_USER_IDが
#    実値になってから切り替えること）
DRY_RUN=1
